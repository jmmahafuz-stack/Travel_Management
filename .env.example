# Local development
DJANGO_SECRET_KEY=changeme
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Keep DATABASE_URL unset on your laptop unless you intentionally want to connect to the live DB.
# DATABASE_URL=

# Keep Cloudinary unset on your laptop unless you intentionally want live media uploads.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Local admin credentials for machine-only testing
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=1

# Production-only values (set only in Render / live server)
# USE_LIVE_DATABASE=true
# USE_CLOUDINARY=true
# DATABASE_URL=postgres://...
# DJANGO_DEBUG=False
# CLOUDINARY_CLOUD_NAME=...
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...
# ADMIN_USERNAME=your-live-admin
# ADMIN_EMAIL=your-email@example.com
# ADMIN_PASSWORD=your-secure-password
